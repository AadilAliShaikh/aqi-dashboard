# Server
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./data/airquality.db

# OpenAQ API (https://docs.openaq.org/)
# v3 requires a free API key — register at https://explore.openaq.org/register
OPENAQ_API_BASE=https://api.openaq.org/v3
OPENAQ_API_KEY=

# CPCB (Central Pollution Control Board, India) — public open-data portal
# https://www.data.gov.in/resource/real-time-air-quality-index-various-locations
CPCB_API_BASE=https://api.data.gov.in/resource
CPCB_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
CPCB_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b

# Ingestion
INGEST_CRON=0 */1 * * *
DEFAULT_CITIES=Delhi,Mumbai,Bengaluru,Kolkata,Chennai,Hyderabad,Pune,Lucknow

# CORS
CORS_ORIGIN=http://localhost:5173
